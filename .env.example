# 개발용 비밀키 파일 형식 (이 파일은 예시이고 값을 넣지 않습니다)
# 사용법: 이 파일을 같은 폴더에 `.env`로 복사한 뒤 값을 채우세요. `.env`는 git에 올라가지 않습니다.
# 키를 채팅이나 `!` 명령으로 입력하지 마세요. 편집기로 직접 채우세요.

# 한국투자증권 Open API (실전 계좌 키 권장)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_HTS_ID=

# 클라우드 LLM: 하나 이상 채우세요
LLM_ANTHROPIC_KEY=
LLM_OPENAI_KEY=
LLM_GOOGLE_KEY=
# 개발용: 실연동 테스트에만 쓴다. 앱은 연결별로 저장한다.
# KIS_TEST_ACCOUNT=
# KIWOOM_TEST_APP_KEY=
# KIWOOM_TEST_APP_SECRET=
# MERITZ_TEST_APP_KEY=
# MERITZ_TEST_APP_SECRET=
# 개발용: 분류표 생성 도구(sidecar/tools/build_categories.py)의 SEC 요청자 표시. 앱은 쓰지 않는다.
# 값은 "서비스 이름 연락처 이메일" 형식이고 개인 이메일이 들어가므로 출력하거나 커밋하지 않는다.
SEC_USER_AGENT=
