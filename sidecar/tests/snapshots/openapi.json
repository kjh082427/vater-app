        "description": "모든 오류 응답의 형식. UI는 `code`로 안내 문구를 정한다.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "Health": {
        "properties": {
