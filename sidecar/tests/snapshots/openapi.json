            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "KisSample": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "price": {
            "title": "Price",
            "type": "number"
          }
        },
        "required": [
          "code",
          "price"
        ],
        "title": "KisSample",
        "type": "object"
      },
      "KisTestResult": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "sample": {
            "$ref": "#/components/schemas/KisSample"
          },
          "server": {
            "title": "Server",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "server",
          "sample"
        ],
        "title": "KisTestResult",
        "type": "object"
      },
      "SecretValue": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "title": "SecretValue",
        "type": "object"
      },
      "ShutdownAccepted": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ShutdownAccepted",
        "type": "object"
      },
      "SymbolOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "exchange": {
            "title": "Exchange",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "market": {
            "title": "Market",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "name_en": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
